# Lakehouse / MinIO — copie en .env et ajuste si besoin.
RAG_S3_ENDPOINT=http://localhost:9000
RAG_S3_ACCESS_KEY=minioadmin
RAG_S3_SECRET_KEY=minioadmin
RAG_S3_REGION=us-east-1
RAG_S3_BUCKET=lakehouse
RAG_ICEBERG_NS=lakehouse

# Modèles / matériel (optionnel)
# RAG_DEVICE=cuda
# RAG_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# RAG_LLM_ADAPTER=auto        # charge le dernier adaptateur LoRA (fine-tuning)
