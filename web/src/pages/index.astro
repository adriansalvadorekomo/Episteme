---
// Produit de chat (façon claude.ai) : barre latérale de conversations, fil de
// discussion, sélecteur de mode LLM/RAG, et réglages de profil. Pas de landing —
// une application. L'index FAISS + le LLM sont servis par l'API FastAPI (voir /api).
// Motion : GSAP (src/lib/motion.ts) — entrées/sorties symétriques, logo animé.
import Logo from '../components/Logo.astro';
---

<!doctype html>
<html lang="en" data-mode="llm">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Episteme — Engineering Knowledge Intelligence</title>
    <meta
      name="description"
      content="Episteme — an AI-powered knowledge platform for software engineering. Understand. Connect. Engineer."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="app" id="app">
      <!-- ░░░░░░░░░░ SIDEBAR ░░░░░░░░░░ -->
      <aside class="side" id="side" aria-label="Conversations">
        <div class="side-top">
          <span class="brand" id="brand">
            <Logo size={30} class="logo-side" />
            <span class="brand-text"><span class="brand-id">Epistem<span class="slash">e</span></span><span class="label brand-sub">KNOWLEDGE INTELLIGENCE</span></span>
          </span>
          <button class="icon-btn side-collapse" id="sideClose" type="button" aria-label="Close menu" title="Close menu">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 6-6 6 6 6"/></svg>
          </button>
        </div>

        <button class="new-chat" id="newChat" type="button">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
          New chat
        </button>

        <p class="label side-section">CHATS</p>
        <nav class="convos" id="convos" aria-label="Chat history"></nav>

        <button class="side-link" id="helpBtn" type="button">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
          Help &amp; tutorial
        </button>

        <!-- profile / settings -->
        <div class="profile">
          <button class="profile-btn" id="profileBtn" type="button" aria-haspopup="dialog">
            <span class="avatar" id="avatar">A</span>
            <span class="profile-meta">
              <span class="profile-name" id="profileName">You</span>
              <span class="label profile-stat" id="profileStat">● connecting…</span>
            </span>
            <svg class="gear" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>
          </button>
        </div>
      </aside>

      <!-- scrim for mobile drawer -->
      <div class="scrim" id="scrim" hidden></div>

      <!-- ░░░░░░░░░░ CHAT COLUMN ░░░░░░░░░░ -->
      <main class="chat" id="chat">
        <header class="topbar">
          <button class="icon-btn side-open" id="sideOpen" type="button" aria-label="Open menu" title="Menu">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <span class="topbar-title" id="topTitle">New chat</span>
        </header>

        <div class="thread" id="thread">
          <div class="thread-inner" id="threadInner">
            <!-- empty-state greeting (shown when a conversation has no messages) -->
            <div class="greeting" id="greeting">
              <Logo size={60} class="logo-hero" label="Episteme" />
              <p class="label greet-fig">EPISTEME · UNDERSTAND · CONNECT · ENGINEER</p>
              <h1 class="greet-h" id="greetH">Good evening.</h1>
              <p class="greet-sub">
                Your knowledge platform for software engineering. <span class="k">Reasoning</span>
                explains from first principles; <span class="k">Knowledge</span> grounds every answer
                in your sources — connected as a graph — with citations <span class="cite-ex">[n]</span>.
              </p>
              <div class="pillars" aria-hidden="true">
                <span class="pillar"><b>KNOWLEDGE</b><span>RAG</span></span>
                <span class="pillar"><b>RELATIONS</b><span>Graph-RAG</span></span>
                <span class="pillar"><b>REASONING</b><span>LLMs</span></span>
              </div>
            </div>
            <!-- messages render here -->
          </div>
        </div>

        <!-- composer docks: moved into the greeting block when empty, here otherwise -->
        <div class="composer-dock" id="bottomDock">
          <form class="composer" id="composerForm">
            <div class="attachments" id="attachments" aria-live="polite"></div>
            <textarea id="askInput" rows="1" autocomplete="off" spellcheck="false"
              placeholder="Ask Episteme about software engineering…" aria-label="Message"></textarea>
            <div class="composer-bar">
              <div class="composer-left">
                <button type="button" id="attachBtn" class="attach" aria-label="Add a document to the assistant's knowledge" title="Add a document the assistant can read">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
                </button>
                <input type="file" id="composerFile" accept=".pdf,.md,.txt" multiple hidden />
                <div class="selector mini" data-mode-switch role="group" aria-label="Assistant mode">
                  <span class="sel-side" data-for="llm"><span class="sel-k">LLM</span></span>
                  <button class="sel-switch" type="button" role="switch" aria-checked="false" aria-label="Toggle LLM / RAG mode">
                    <span class="sel-track"><span class="sel-knob"></span></span>
                  </button>
                  <span class="sel-side" data-for="rag"><span class="sel-k">RAG</span></span>
                </div>
              </div>
              <button type="submit" id="runBtn" class="send" aria-label="Send" disabled>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5m-7 7 7-7 7 7"/></svg>
              </button>
            </div>
          </form>
          <p class="composer-foot label" id="composerFoot">MODE / LLM · intuition, no sources</p>
        </div>
      </main>
    </div>

    <!-- ░░░░░░░░░░ SETTINGS DIALOG ░░░░░░░░░░ -->
    <div class="modal" id="settings" hidden>
      <div class="modal-scrim" data-close></div>
      <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="setTitle">
        <div class="modal-head">
          <h2 class="modal-title" id="setTitle">Settings</h2>
          <button class="icon-btn" id="setClose" type="button" aria-label="Close settings">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>

        <div class="modal-body">
          <section class="set-row">
            <label class="set-label" for="setName">PROFILE NAME</label>
            <input class="set-input" id="setName" type="text" maxlength="40" placeholder="You" autocomplete="off" />
            <p class="set-help">Used for the greeting on a new chat.</p>
          </section>

          <section class="set-row">
            <span class="set-label">DEFAULT MODE</span>
            <div class="seg" id="setMode" role="group" aria-label="Default mode">
              <button type="button" class="seg-btn" data-mode="llm">LLM · intuition</button>
              <button type="button" class="seg-btn" data-mode="rag">RAG · evidence</button>
            </div>
            <p class="set-help">The mode each new chat starts in.</p>
          </section>

          <section class="set-row">
            <label class="set-label" for="setTopK">RETRIEVAL DEPTH · <b id="topKVal">5</b> chunks</label>
            <input class="set-range" id="setTopK" type="range" min="1" max="15" step="1" value="5" />
            <p class="set-help">How many corpus passages RAG retrieves per answer.</p>
          </section>

          <section class="set-row">
            <span class="set-label">BACKEND</span>
            <dl class="set-info" id="setInfo">
              <div><dt>status</dt><dd id="infoStatus">—</dd></div>
              <div><dt>device</dt><dd id="infoDevice">—</dd></div>
              <div><dt>embeddings</dt><dd id="infoEmbed">—</dd></div>
              <div><dt>llm</dt><dd id="infoLlm">—</dd></div>
              <div><dt>chunks</dt><dd id="infoChunks">—</dd></div>
            </dl>
          </section>

          <section class="set-row">
            <span class="set-label">KNOWLEDGE BASE</span>
            <button class="btn-plain" id="openKbFromSettings" type="button">Manage documents →</button>
            <p class="set-help">See and add the documents the assistant reads to answer you.</p>
          </section>

          <section class="set-row danger">
            <span class="set-label">DATA</span>
            <button class="btn-danger" id="clearAll" type="button">Delete all conversations</button>
            <p class="set-help">Chats are stored only in this browser.</p>
          </section>
        </div>
      </div>
    </div>

    <!-- ░░░░░░░░░░ HELP / TUTORIAL DIALOG ░░░░░░░░░░ -->
    <div class="modal" id="help" hidden>
      <div class="modal-scrim" data-close-help></div>
      <div class="modal-card help-card" role="dialog" aria-modal="true" aria-labelledby="helpTitle">
        <div class="modal-head">
          <h2 class="modal-title" id="helpTitle">Welcome to Episteme</h2>
          <button class="icon-btn" id="helpClose" type="button" aria-label="Close help">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>

        <div class="modal-body">
          <p class="help-lede">
            Episteme is your knowledge platform for software engineering —
            <b>Understand. Connect. Engineer.</b> It <b>reasons</b> with an LLM and
            <b>grounds</b> answers in a knowledge base connected as a graph, with citations.
            Two modes let you choose — compare them to see the difference.
          </p>

          <ol class="steps">
            <li class="step">
              <span class="step-n">01</span>
              <div class="step-body">
                <h3 class="step-h">Reasoning or Knowledge</h3>
                <p>Flip the switch in the composer.
                  <span class="tag tag-llm">LLM</span> is <b>Reasoning</b> — it explains from first
                  principles, fast and fluent, <em>without sources</em>.
                  <span class="tag tag-rag">RAG</span> is <b>Knowledge</b> — it retrieves from your
                  knowledge base (connected as a graph) and answers with citations. Each chat keeps its own mode.</p>
              </div>
            </li>
            <li class="step">
              <span class="step-n">02</span>
              <div class="step-body">
                <h3 class="step-h">Ask a question</h3>
                <p>Type in the composer and press <kbd>Enter</kbd> to send, or
                  <kbd>Shift</kbd>+<kbd>Enter</kbd> for a new line. On a fresh chat you can also
                  tap a suggested question to start.</p>
              </div>
            </li>
            <li class="step">
              <span class="step-n">03</span>
              <div class="step-body">
                <h3 class="step-h">Read the evidence</h3>
                <p>In RAG mode the reply carries a <span class="chip grounded">GROUNDED</span>
                  badge and inline citations like <span class="cite-ex">[1]</span>. Click a
                  citation to jump to the exact source passage in the <b>Sources</b> list below
                  the answer. An <span class="chip ungrounded">UNGROUNDED</span> badge means the
                  model answered from intuition alone.</p>
              </div>
            </li>
            <li class="step">
              <span class="step-n">04</span>
              <div class="step-body">
                <h3 class="step-h">Manage your chats</h3>
                <p><b>New chat</b> starts a fresh thread. Double-click a chat’s title to rename
                  it, and use the trash icon to delete it. Everything is stored locally in this
                  browser — nothing leaves your machine except the question sent to your own API.</p>
              </div>
            </li>
            <li class="step">
              <span class="step-n">05</span>
              <div class="step-body">
                <h3 class="step-h">Tune it in Settings</h3>
                <p>Open <b>Settings</b> from your profile at the bottom of the sidebar to set your
                  name, the default mode for new chats, and the <b>retrieval depth</b> (how many
                  corpus passages RAG pulls per answer). The backend model and device are shown there too.</p>
              </div>
            </li>
          </ol>

          <p class="help-foot">
            <b>Try this:</b> ask “What is a Pod in Kubernetes?” in LLM mode, then flip to RAG and
            ask again. The second answer will cite the course.
          </p>
          <button class="help-cta" id="helpStart" type="button">Got it — start chatting</button>
        </div>
      </div>
    </div>

    <!-- ░░░░░░░░░░ KNOWLEDGE BASE (LAKEHOUSE) DIALOG ░░░░░░░░░░ -->
    <div class="modal" id="knowledge" hidden>
      <div class="modal-scrim" data-close-kb></div>
      <div class="modal-card kb-card" role="dialog" aria-modal="true" aria-labelledby="kbTitle">
        <div class="modal-head">
          <h2 class="modal-title" id="kbTitle">Knowledge base</h2>
          <button class="icon-btn" id="kbClose" type="button" aria-label="Close">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="modal-body">
          <p class="kb-lede">
            Teach the assistant from your own material. Add a <b>PDF, Markdown, or text file</b>
            and it will read it, then use it to answer your questions — with citations back to
            your file. The assistant files each document under the right topic <b>automatically</b>.
          </p>

          <label class="kb-drop" id="kbDrop">
            <input type="file" id="kbFile" accept=".pdf,.md,.txt" multiple hidden />
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5-5 5 5"/><path d="M12 5v12"/></svg>
            <span class="kb-drop-t">Drag a file here, or</span>
            <span class="kb-import">Import documents</span>
            <span class="kb-drop-s label">PDF · Markdown · TXT — topic detected automatically</span>
          </label>
          <div class="kb-queue" id="kbQueue"></div>

          <div class="kb-list-head">
            <span class="set-label">What the assistant knows · <b id="kbCount">—</b> documents</span>
            <button class="kb-refresh" id="kbRefresh" type="button">refresh</button>
          </div>
          <div class="kb-table" id="kbTable"><p class="set-help">Loading…</p></div>
        </div>
      </div>
    </div>

    <div class="toasts" id="toasts" aria-live="polite"></div>

    <style is:global>
      :root {
        --canvas: #0a0a0a;
        --surface: #0e0f10;
        --surface-2: #141516;
        --fg: #ededed;
        --muted: #8a8a8a;
        --faint: #5a5c5e;
        --accent-llm: #ff5a1f;
        --accent-rag: #16c7c7;
        --accent: var(--accent-llm);
        --line: color-mix(in oklab, var(--fg) 12%, transparent);
        --line-soft: color-mix(in oklab, var(--fg) 7%, transparent);
        --wash: color-mix(in oklab, var(--accent) 14%, transparent);
        --edge: color-mix(in oklab, var(--accent) 40%, transparent);

        --fs--1: clamp(0.68rem, 0.66rem + 0.1vw, 0.74rem);
        --fs-0: clamp(0.9rem, 0.87rem + 0.16vw, 1rem);
        --fs-1: clamp(1.05rem, 0.98rem + 0.35vw, 1.3rem);
        --fs-2: clamp(1.6rem, 1.2rem + 1.6vw, 2.6rem);

        --s1: 0.5rem; --s2: 1rem; --s3: 1.5rem; --s4: 2rem; --s6: 3rem;

        --mono: "JetBrains Mono", ui-monospace, monospace;
        --display: "Inter Tight", ui-sans-serif, system-ui, sans-serif;
        --ease: cubic-bezier(0.22, 1, 0.36, 1);
        --radius: 4px;
        --side-w: 16rem;
      }
      :root[data-mode="llm"] { --accent: var(--accent-llm); }
      :root[data-mode="rag"] { --accent: var(--accent-rag); }

      *, *::before, *::after { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; block-size: 100%; }
      body {
        margin: 0; block-size: 100svh; overflow: hidden;
        background: var(--canvas); color: var(--fg);
        font-family: var(--mono); font-size: var(--fs-0); line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      ::selection { background: color-mix(in oklab, var(--accent) 38%, transparent); color: #fff; }
      ::-webkit-scrollbar { inline-size: 10px; }
      ::-webkit-scrollbar-thumb { background: var(--surface-2); border-radius: 999px; border: 2px solid var(--canvas); }
      * { scrollbar-width: thin; scrollbar-color: var(--surface-2) transparent; }
      a { color: inherit; text-decoration: none; }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      .label { font-family: var(--mono); font-size: var(--fs--1); font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--muted); }
      .k { color: var(--accent); font-weight: 700; transition: color 0.5s var(--ease); }
      .cite-ex { color: var(--accent-rag); font-weight: 700; }

      .icon-btn { display: inline-grid; place-items: center; inline-size: 34px; block-size: 34px; color: var(--muted); background: transparent; border: 1px solid transparent; border-radius: var(--radius); cursor: pointer; transition: color 0.2s, background 0.2s, border-color 0.2s; }
      .icon-btn:hover { color: var(--fg); background: var(--surface-2); }

      /* ── app shell ── */
      .app { display: grid; grid-template-columns: var(--side-w) 1fr; block-size: 100svh; }

      /* ── sidebar ── */
      .side {
        display: flex; flex-direction: column; min-block-size: 0;
        background: #0c0d0e; border-inline-end: 1px solid var(--line-soft);
        padding: var(--s2);
      }
      .side-top { display: flex; align-items: center; justify-content: space-between; gap: var(--s1); margin-block-end: var(--s3); }
      .brand { display: flex; align-items: center; gap: 0.65rem; cursor: default; }
      .brand-text { display: flex; flex-direction: column; gap: 1px; line-height: 1.2; }

      /* ── Episteme logo (animated by GSAP; hidden until the intro sets it up) ── */
      .logo { visibility: hidden; color: var(--fg); overflow: visible; flex-shrink: 0; }
      .lg-spine, .lg-arm { stroke: currentColor; stroke-width: 3; stroke-linecap: round; }
      .lg-link { stroke: var(--accent); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; opacity: 0.6; transition: stroke 0.5s var(--ease); }
      .lg-node { fill: var(--accent); transition: fill 0.5s var(--ease); }
      .lg-signal { fill: #fff; }
      .logo-hero { display: block; margin-block-end: var(--s3); }
      .brand-id { font-family: var(--mono); font-weight: 700; font-size: var(--fs-0); letter-spacing: 0.08em; }
      .brand-id .slash { color: var(--accent); transition: color 0.5s var(--ease); }
      .brand-sub { letter-spacing: 0.12em; }
      .side-collapse { display: none; }

      .new-chat {
        display: flex; align-items: center; gap: var(--s1);
        inline-size: 100%; padding: 0.6rem 0.8rem; margin-block-end: var(--s3);
        font-family: var(--mono); font-size: var(--fs-0); color: var(--fg);
        background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--radius);
        cursor: pointer; transition: border-color 0.2s, background 0.2s;
      }
      .new-chat:hover { border-color: var(--accent); }
      .new-chat svg { color: var(--accent); transition: color 0.5s var(--ease); }

      .side-section { padding-inline: 0.25rem; margin: 0 0 var(--s1); }
      .convos { flex: 1; min-block-size: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 2px; margin: 0 -0.25rem; padding: 0 0.25rem; }
      .convo { position: relative; display: flex; align-items: center; gap: var(--s1); padding: 0.5rem 0.6rem; border-radius: var(--radius); cursor: pointer; color: var(--muted); border: 1px solid transparent; transition: background 0.15s, color 0.15s; }
      .convo:hover { background: var(--surface-2); color: var(--fg); }
      .convo.active { background: var(--surface-2); color: var(--fg); border-color: var(--line-soft); }
      .convo-dot { inline-size: 6px; block-size: 6px; border-radius: 50%; flex-shrink: 0; background: var(--faint); }
      .convo.m-llm .convo-dot { background: var(--accent-llm); }
      .convo.m-rag .convo-dot { background: var(--accent-rag); }
      .convo-title { flex: 1; min-inline-size: 0; font-size: var(--fs--1) + 0.02rem; font-size: 0.82rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .convo-title[contenteditable="true"] { white-space: nowrap; outline: none; color: var(--fg); border-bottom: 1px solid var(--accent); }
      .convo-del { opacity: 0; flex-shrink: 0; display: grid; place-items: center; inline-size: 22px; block-size: 22px; border: 0; background: transparent; color: var(--faint); border-radius: 3px; cursor: pointer; transition: opacity 0.15s, color 0.15s, background 0.15s; }
      .convo:hover .convo-del, .convo.active .convo-del { opacity: 1; }
      .convo-del:hover { color: var(--accent-llm); background: color-mix(in oklab, var(--accent-llm) 14%, transparent); }
      .convos-empty { color: var(--faint); font-size: var(--fs--1); padding: 0.5rem 0.6rem; }

      /* profile */
      .profile { margin-block-start: var(--s2); padding-block-start: var(--s2); border-block-start: 1px solid var(--line-soft); }
      .profile-btn { inline-size: 100%; display: flex; align-items: center; gap: var(--s2); padding: 0.5rem; background: transparent; border: 1px solid transparent; border-radius: var(--radius); cursor: pointer; color: var(--fg); transition: background 0.2s, border-color 0.2s; }
      .profile-btn:hover { background: var(--surface-2); border-color: var(--line-soft); }
      .avatar { display: grid; place-items: center; inline-size: 30px; block-size: 30px; flex-shrink: 0; border-radius: 6px; background: color-mix(in oklab, var(--accent) 22%, var(--surface-2)); color: var(--fg); font-family: var(--mono); font-weight: 700; font-size: 0.85rem; transition: background 0.5s var(--ease); }
      .profile-meta { flex: 1; min-inline-size: 0; display: flex; flex-direction: column; gap: 1px; text-align: start; }
      .profile-name { font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .profile-stat { letter-spacing: 0.1em; color: var(--muted); }
      .profile-stat[data-ok] { color: var(--accent-rag); }
      .gear { color: var(--muted); flex-shrink: 0; }

      .scrim { position: fixed; inset: 0; z-index: 30; background: rgb(0 0 0 / 0.5); }

      /* ── chat column ── */
      .chat { display: flex; flex-direction: column; min-block-size: 0; min-inline-size: 0; }
      .topbar {
        display: flex; align-items: center; gap: var(--s2);
        padding: var(--s1) var(--s3); min-block-size: 3.25rem;
        border-block-end: 1px solid var(--line-soft);
        background: color-mix(in oklab, var(--canvas) 80%, transparent); backdrop-filter: blur(10px);
      }
      .side-open { display: none; }
      .topbar-title { flex: 1; min-inline-size: 0; font-size: var(--fs-0); color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

      /* ── mode selector (hardware switch) ── */
      .selector { display: inline-flex; align-items: center; gap: var(--s2); user-select: none; }
      .sel-side { display: flex; flex-direction: column; gap: 1px; text-align: center; cursor: pointer; transition: opacity 0.4s var(--ease); opacity: 0.4; }
      .sel-k { font-family: var(--mono); font-weight: 700; font-size: var(--fs-0); letter-spacing: 0.08em; }
      .sel-sub { font-family: var(--mono); font-size: var(--fs--1); letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
      :root[data-mode="llm"] .sel-side[data-for="llm"], :root[data-mode="rag"] .sel-side[data-for="rag"] { opacity: 1; }
      :root[data-mode="llm"] .sel-side[data-for="llm"] .sel-k { color: var(--accent-llm); }
      :root[data-mode="rag"] .sel-side[data-for="rag"] .sel-k { color: var(--accent-rag); }
      .sel-switch { padding: 0; background: none; border: 0; cursor: pointer; }
      .sel-track { display: block; inline-size: 56px; block-size: 28px; padding: 3px; background: var(--surface-2); border: 1px solid var(--line); border-radius: 6px; box-shadow: inset 0 2px 5px rgb(0 0 0 / 0.6); }
      .sel-knob { display: grid; place-items: center; inline-size: 22px; block-size: 20px; border-radius: var(--radius); background: linear-gradient(180deg, #2a2b2c, #171819); border: 1px solid color-mix(in oklab, var(--fg) 22%, transparent); border-block-start-color: color-mix(in oklab, var(--fg) 34%, transparent); box-shadow: 0 3px 6px rgb(0 0 0 / 0.5); transition: translate 0.34s var(--ease); }
      .sel-knob::after { content: ""; inline-size: 3px; block-size: 9px; border-radius: 2px; background: var(--accent); transition: background 0.4s var(--ease); }
      :root[data-mode="rag"] .sel-knob { translate: 28px 0; }
      .sel-switch:active .sel-knob { scale: 0.94; }
      .selector.mini { gap: var(--s1); }
      .selector.mini .sel-sub { display: none; }

      /* ── thread ── */
      .thread { flex: 1; min-block-size: 0; overflow-y: auto; overflow-x: hidden; }
      .thread-inner { max-inline-size: 48rem; margin-inline: auto; padding: var(--s4) var(--s3) var(--s6); display: flex; flex-direction: column; gap: var(--s4); min-block-size: 100%; }

      /* empty-state greeting (centers its block + the docked composer) */
      .greeting { margin: auto 0; padding-block: var(--s6); }
      .app.empty .thread-inner { justify-content: center; }
      .greet-fig { display: block; margin-block-end: var(--s2); }
      .greet-h { font-family: var(--display); font-weight: 600; letter-spacing: -0.03em; line-height: 1; font-size: var(--fs-2); margin: 0 0 var(--s2); text-wrap: balance; }
      .greet-sub { color: var(--muted); max-inline-size: 52ch; margin: 0 0 var(--s3); text-wrap: pretty; line-height: 1.6; }
      .pillars { display: flex; flex-wrap: wrap; gap: var(--s1); margin-block-end: var(--s4); }
      .pillar { display: flex; flex-direction: column; gap: 1px; padding: 0.5rem 0.85rem; background: var(--surface); border: 1px solid var(--line-soft); border-radius: var(--radius); }
      .pillar b { font-family: var(--mono); font-size: var(--fs--1); font-weight: 700; letter-spacing: 0.14em; color: var(--fg); }
      .pillar span { font-family: var(--mono); font-size: var(--fs--1); letter-spacing: 0.08em; color: var(--accent); transition: color 0.5s var(--ease); }
      .suggests { display: flex; flex-wrap: wrap; gap: var(--s1); margin-block-start: var(--s3); }
      .suggest { font-family: var(--mono); font-size: var(--fs--1); letter-spacing: 0.04em; color: var(--muted); background: var(--surface); border: 1px solid var(--line-soft); border-radius: 999px; padding: 0.4rem 0.85rem; cursor: pointer; transition: color 0.2s, border-color 0.2s; }
      .suggest:hover { color: var(--fg); border-color: var(--accent); }

      /* messages */
      .msg { display: flex; flex-direction: column; gap: 0.4rem; }
      .msg.user { align-items: flex-end; }
      .msg.user .bubble { max-inline-size: 85%; padding: 0.7rem 1rem; background: var(--surface-2); border: 1px solid var(--line-soft); border-radius: 16px 16px 4px 16px; color: var(--fg); white-space: pre-wrap; word-break: break-word; }
      .msg-role { display: inline-flex; align-items: center; gap: 0.6ch; }
      .msg-role .dot { inline-size: 6px; block-size: 6px; border-radius: 50%; background: var(--accent); transition: background 0.5s var(--ease); }
      .msg.assistant .body { max-inline-size: 100%; }

      /* status chips */
      .chip { display: inline-flex; align-items: center; gap: 0.5ch; margin-block-end: var(--s1); padding: 0.25rem 0.6rem; font-family: var(--mono); font-size: var(--fs--1); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; border-radius: var(--radius); }
      .chip.grounded { color: var(--accent-rag); background: color-mix(in oklab, var(--accent-rag) 14%, transparent); border: 1px solid color-mix(in oklab, var(--accent-rag) 40%, transparent); }
      .chip.ungrounded { color: var(--accent-llm); background: color-mix(in oklab, var(--accent-llm) 12%, transparent); border: 1px solid color-mix(in oklab, var(--accent-llm) 38%, transparent); }
      .chip.scope { color: var(--muted); background: var(--surface-2); border: 1px solid var(--line); }
      .chip::before { content: ""; inline-size: 6px; block-size: 6px; border-radius: 50%; background: currentColor; }

      /* answer markdown */
      .answer { font-size: var(--fs-0); line-height: 1.75; color: #dcdcdc; }
      .answer p { margin: 0 0 0.7rem; text-wrap: pretty; }
      .answer p:last-child { margin-block-end: 0; }
      .answer ul, .answer ol { margin: 0 0 0.7rem; padding-inline-start: 1.2rem; }
      .answer li { margin-block: 0.2rem; }
      .answer li::marker { color: var(--accent); }
      .answer strong { color: #fff; }
      .answer code { font-size: 0.88em; color: color-mix(in oklab, var(--accent), white 20%); background: var(--wash); padding: 1px 5px; border-radius: 3px; }
      .answer pre { background: #060606; border: 1px solid var(--line); border-radius: var(--radius); padding: 0.75rem 0.9rem; overflow-x: auto; margin: 0 0 0.7rem; }
      .answer pre code { background: none; color: #cfcfcf; padding: 0; }
      .answer h3, .answer h4, .answer h5, .answer h6 { font-family: var(--display); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; color: #fff; margin: 1.1em 0 0.4em; }
      .answer h3 { font-size: 1.18em; }
      .answer h4 { font-size: 1.04em; }
      .answer h5, .answer h6 { font-size: 0.96em; color: var(--fg); }
      .answer > .chip + h3, .answer > .chip + h4 { margin-block-start: 0.3rem; }
      .answer em { font-style: italic; color: #e8e8e8; }
      .answer a { color: var(--accent-rag); text-decoration: underline; text-underline-offset: 2px; }
      .answer blockquote { margin: 0 0 0.7rem; padding: 0.15rem 0 0.15rem 0.9rem; border-inline-start: 2px solid var(--edge); color: var(--muted); }
      .answer blockquote p { margin: 0.2rem 0; }
      .answer hr { border: 0; border-block-start: 1px solid var(--line); margin: 1rem 0; }
      .cite { cursor: pointer; color: var(--accent-rag); font-weight: 700; font-size: 0.82em; vertical-align: super; padding: 0 1px; transition: color 0.15s; }
      .cite:hover { color: #fff; }

      /* sources (Perplexity-style, collapsible under the answer) */
      .sources-wrap { margin-block-start: var(--s2); }
      .sources-sum { display: inline-flex; align-items: center; gap: 0.6ch; cursor: pointer; list-style: none; color: var(--muted); font-family: var(--mono); font-size: var(--fs--1); letter-spacing: 0.14em; text-transform: uppercase; }
      .sources-sum::-webkit-details-marker { display: none; }
      .sources-sum::before { content: "▸"; color: var(--accent-rag); transition: rotate 0.2s var(--ease); }
      details[open] .sources-sum::before { rotate: 90deg; }
      .sources { display: grid; gap: var(--s1); margin-block-start: var(--s2); }
      .src-card { display: block; padding: 0.7rem 0.8rem; background: var(--surface); border: 1px solid var(--line-soft); border-radius: var(--radius); scroll-margin: 5rem; transition: border-color 0.2s var(--ease); }
      .src-card.flash { border-color: var(--accent-rag); }
      .src-head { display: flex; align-items: center; gap: 0.5ch; margin-block-end: 0.3rem; }
      .src-n { font-weight: 700; color: var(--accent-rag); font-size: var(--fs--1); }
      .src-path { font-size: var(--fs--1); color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .src-score { margin-inline-start: auto; font-size: var(--fs--1); color: var(--faint); font-variant-numeric: tabular-nums; }
      .src-snip { font-size: var(--fs--1); line-height: 1.5; color: var(--faint); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

      /* ── Thinking status line (Claude Code style): ✻ glyph + rotating verb + timer ── */
      .cc { display: grid; gap: 0.75rem; font-family: var(--mono); }
      .cc-line { display: flex; align-items: baseline; gap: 0.7ch; font-size: var(--fs-0); }
      .cc-glyph { display: inline-block; inline-size: 1.2ch; text-align: center; color: var(--accent); transition: color 0.5s var(--ease); }
      .cc-verb {
        display: inline-block; font-weight: 500; color: var(--accent);
        background: linear-gradient(90deg, var(--accent) 0 38%, color-mix(in oklab, var(--accent), white 70%) 50%, var(--accent) 62% 100%);
        background-size: 260% 100%; -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
        animation: ccshimmer 2.1s linear infinite;
      }
      @keyframes ccshimmer { from { background-position: 100% 0; } to { background-position: -160% 0; } }
      .cc-time { color: var(--faint); font-size: var(--fs--1); font-variant-numeric: tabular-nums; }
      @keyframes genblink { 50% { opacity: 0; } }

      /* live GPU instrument cluster */
      .gpu-live { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.45rem; max-inline-size: 34rem; }
      .g { display: grid; gap: 0.28rem; padding: 0.5rem 0.65rem; background: var(--surface); border: 1px solid var(--line-soft); border-radius: 6px; }
      .g-top { display: flex; align-items: baseline; justify-content: space-between; gap: 0.5ch; }
      .gl { font-size: 0.6rem; letter-spacing: 0.18em; color: var(--faint); text-transform: uppercase; }
      .gv { font-size: var(--fs--1); color: var(--fg); font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
      .gv small { color: var(--faint); font-weight: 500; }
      .gbar { display: block; block-size: 3px; background: var(--line); border-radius: 2px; overflow: hidden; }
      .gbar i { display: block; block-size: 100%; inline-size: 0; background: var(--accent); border-radius: 2px; transition: background 0.5s var(--ease); }
      .gpu-name { font-size: 0.62rem; letter-spacing: 0.12em; color: var(--faint); text-transform: uppercase; }
      @media (max-width: 40rem) { .gpu-live { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

      /* inference receipt under each answer */
      .receipt { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem; margin-block-start: var(--s2); padding-block-start: 0.6rem; border-block-start: 1px dashed var(--line-soft); }
      .rc { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.04em; color: var(--muted); padding: 0.2rem 0.55rem; border: 1px solid var(--line-soft); border-radius: 999px; background: var(--surface); white-space: nowrap; }
      .rc b { color: var(--fg); font-weight: 600; font-variant-numeric: tabular-nums; }
      .rc.hot { border-color: color-mix(in oklab, var(--accent) 40%, var(--line-soft)); }
      .rc.hot b { color: var(--accent); }
      .rc.dev { color: var(--faint); border-style: dashed; }
      .receipt .bolt { color: var(--accent); font-size: 0.75rem; }
      .err { color: var(--accent-llm); }

      /* ── composer attachments (claude-style chips; symmetric in/out via GSAP) ── */
      .attachments { display: flex; flex-wrap: wrap; padding-inline: 0.2rem; margin-block-end: 0.45rem; overflow: hidden; }
      .attachments:empty { display: none; }
      .chip-att {
        display: inline-flex; align-items: center; gap: 0.5rem; margin-right: 0.4rem; margin-block: 0.15rem;
        padding: 0.32rem 0.7rem 0.32rem 0.38rem; background: var(--surface-2); border: 1px solid var(--line);
        border-radius: 10px; font-size: var(--fs--1); white-space: nowrap; overflow: hidden; max-inline-size: 24rem;
        transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
      }
      .ca-ico { display: grid; place-items: center; inline-size: 24px; block-size: 24px; flex-shrink: 0; border-radius: 7px; color: var(--accent); background: color-mix(in oklab, var(--accent) 14%, transparent); transition: color 0.3s, background 0.3s; }
      .ca-name { color: var(--fg); overflow: hidden; text-overflow: ellipsis; max-inline-size: 12rem; }
      .ca-st { font-family: var(--mono); font-size: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
      .chip-att.ok { border-color: color-mix(in oklab, var(--accent-rag) 45%, var(--line)); }
      .chip-att.ok .ca-ico { color: var(--accent-rag); background: color-mix(in oklab, var(--accent-rag) 16%, transparent); }
      .chip-att.ok .ca-st { color: var(--accent-rag); }
      .chip-att.dup .ca-st { color: var(--muted); }
      .chip-att.err { border-color: color-mix(in oklab, var(--accent-llm) 45%, var(--line)); }
      .chip-att.err .ca-ico { color: var(--accent-llm); background: color-mix(in oklab, var(--accent-llm) 14%, transparent); }
      .chip-att.err .ca-st { color: var(--accent-llm); }

      /* ── composer ── */
      .composer-dock { padding: var(--s1) var(--s3) var(--s3); }
      .greeting + .composer-dock, .thread-inner .composer-dock { padding-inline: 0; }
      .composer-dock > .composer, .composer-dock > .composer-foot { max-inline-size: 48rem; margin-inline: auto; }
      .composer { background: color-mix(in oklab, var(--canvas), var(--fg) 3%); border: 1px solid var(--line); border-radius: 20px; padding: 0.75rem 0.75rem 0.6rem; transition: border-color 0.2s var(--ease), box-shadow 0.2s var(--ease); }
      .composer.drop { border-color: var(--accent); background: color-mix(in oklab, var(--accent) 6%, var(--canvas)); }
      .composer:focus-within { border-color: color-mix(in oklab, var(--fg) 24%, transparent); box-shadow: 0 0 0 4px color-mix(in oklab, var(--fg) 5%, transparent); }
      .composer textarea { display: block; inline-size: 100%; resize: none; border: 0; outline: none; background: transparent; color: var(--fg); font-family: var(--mono); font-size: var(--fs-0); line-height: 1.55; padding: 0.35rem 0.5rem; max-block-size: 11rem; overflow-y: auto; }
      .composer textarea::placeholder { color: var(--faint); }
      .composer-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s2); margin-block-start: 0.35rem; }
      .composer-left { display: flex; align-items: center; gap: var(--s2); }
      .attach {
        appearance: none; -webkit-appearance: none;
        display: inline-grid; place-items: center; inline-size: 32px; block-size: 32px;
        color: var(--muted); background: transparent; border: 0; border-radius: 999px;
        cursor: pointer; transition: color 0.2s var(--ease), background 0.2s var(--ease);
      }
      .attach:hover { color: var(--fg); background: color-mix(in oklab, var(--fg) 10%, transparent); }
      .attach:active { background: color-mix(in oklab, var(--fg) 16%, transparent); }
      .attach.busy { color: var(--accent); animation: attachpulse 1s var(--ease) infinite; }
      @keyframes attachpulse { 50% { opacity: 0.5; } }
      .send { flex-shrink: 0; display: inline-grid; place-items: center; inline-size: 34px; block-size: 34px; color: var(--canvas); background: var(--accent); border: 0; border-radius: 999px; cursor: pointer; transition: background 0.5s var(--ease), opacity 0.2s var(--ease), transform 0.15s var(--ease), filter 0.15s var(--ease); }
      .send:hover:not(:disabled) { filter: brightness(1.1); }
      .send:active:not(:disabled) { transform: scale(0.92); }
      .send:disabled { background: var(--surface-2); color: var(--faint); cursor: default; }
      .composer-foot { display: block; text-align: center; margin-block-start: var(--s1); }

      /* ── settings modal ── */
      .modal { position: fixed; inset: 0; z-index: 40; display: grid; place-items: center; padding: var(--s3); }
      .modal[hidden] { display: none; }
      .modal-scrim { position: absolute; inset: 0; background: rgb(0 0 0 / 0.6); backdrop-filter: blur(4px); }
      .modal-card { position: relative; inline-size: min(34rem, 100%); max-block-size: 86svh; overflow-y: auto; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 24px 60px -24px rgb(0 0 0 / 0.9), inset 0 1px 0 rgb(255 255 255 / 0.06); }
      .modal-head { position: sticky; inset-block-start: 0; display: flex; align-items: center; justify-content: space-between; padding: var(--s3); border-block-end: 1px solid var(--line-soft); background: var(--surface); }
      .modal-title { font-family: var(--display); font-weight: 600; font-size: var(--fs-1); letter-spacing: -0.02em; margin: 0; }
      .modal-body { padding: var(--s3); display: grid; gap: var(--s4); }
      .set-row { display: grid; gap: var(--s1); }
      .set-label { font-family: var(--mono); font-size: var(--fs--1); font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
      .set-label b { color: var(--accent); transition: color 0.5s var(--ease); }
      .set-help { margin: 0; color: var(--faint); font-size: var(--fs--1); line-height: 1.5; }
      .set-input { inline-size: 100%; padding: 0.6rem 0.75rem; background: var(--canvas); border: 1px solid var(--line); border-radius: var(--radius); color: var(--fg); font-family: var(--mono); font-size: var(--fs-0); }
      .set-input:focus-visible { border-color: var(--accent); outline: none; }
      .seg { display: inline-flex; gap: 2px; padding: 3px; background: var(--canvas); border: 1px solid var(--line); border-radius: 6px; inline-size: fit-content; }
      .seg-btn { font-family: var(--mono); font-size: var(--fs--1); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); background: transparent; border: 0; border-radius: var(--radius); padding: 0.45rem 0.8rem; cursor: pointer; transition: color 0.2s, background 0.2s; }
      .seg-btn.active { color: var(--canvas); background: var(--accent); transition: background 0.5s var(--ease); }
      .set-range { inline-size: 100%; accent-color: var(--accent); }
      .set-info { margin: 0; display: grid; gap: 0.4rem; }
      .set-info div { display: flex; justify-content: space-between; gap: var(--s2); font-size: var(--fs--1); border-block-end: 1px solid var(--line-soft); padding-block-end: 0.4rem; }
      .set-info dt { color: var(--faint); text-transform: uppercase; letter-spacing: 0.08em; }
      .set-info dd { margin: 0; color: var(--fg); font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-inline-size: 60%; }
      .btn-danger { inline-size: fit-content; font-family: var(--mono); font-size: var(--fs--1); letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent-llm); background: color-mix(in oklab, var(--accent-llm) 10%, transparent); border: 1px solid color-mix(in oklab, var(--accent-llm) 38%, transparent); border-radius: var(--radius); padding: 0.5rem 0.85rem; cursor: pointer; transition: background 0.2s; }
      .btn-danger:hover { background: color-mix(in oklab, var(--accent-llm) 20%, transparent); }

      /* sidebar help link */
      .side-link { display: flex; align-items: center; gap: var(--s1); inline-size: 100%; padding: 0.5rem 0.6rem; margin-block-start: var(--s1); font-family: var(--mono); font-size: 0.82rem; color: var(--muted); background: transparent; border: 1px solid transparent; border-radius: var(--radius); cursor: pointer; transition: color 0.2s, background 0.2s; }
      .side-link:hover { color: var(--fg); background: var(--surface-2); }
      .side-link svg { color: var(--accent); transition: color 0.5s var(--ease); flex-shrink: 0; }

      /* tutorial steps */
      .help-lede { margin: 0 0 var(--s2); color: var(--muted); line-height: 1.65; text-wrap: pretty; }
      .help-lede b { color: var(--fg); }
      .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s2); counter-reset: s; }
      .step { display: grid; grid-template-columns: auto 1fr; gap: var(--s2); padding: var(--s2); background: var(--canvas); border: 1px solid var(--line-soft); border-radius: 6px; }
      .step-n { font-family: var(--mono); font-weight: 700; font-size: var(--fs--1); letter-spacing: 0.1em; color: var(--accent); transition: color 0.5s var(--ease); padding-block-start: 0.15rem; }
      .step-h { font-family: var(--display); font-weight: 600; font-size: var(--fs-1); letter-spacing: -0.01em; margin: 0 0 0.3rem; }
      .step-body p { margin: 0; color: var(--muted); line-height: 1.6; text-wrap: pretty; }
      .step-body b { color: var(--fg); }
      .step-body em { font-style: normal; color: var(--accent-llm); }
      .step kbd { font-family: var(--mono); font-size: 0.78em; color: var(--fg); background: var(--surface-2); border: 1px solid var(--line); border-block-end-width: 2px; border-radius: 3px; padding: 1px 5px; }
      .step .chip { margin: 0; vertical-align: middle; }
      .tag { display: inline-block; font-family: var(--mono); font-weight: 700; font-size: 0.82em; letter-spacing: 0.06em; padding: 0 4px; border-radius: 3px; }
      .tag-llm { color: var(--accent-llm); background: color-mix(in oklab, var(--accent-llm) 14%, transparent); }
      .tag-rag { color: var(--accent-rag); background: color-mix(in oklab, var(--accent-rag) 14%, transparent); }
      .help-foot { margin: 0; padding: var(--s2); color: var(--muted); line-height: 1.6; background: color-mix(in oklab, var(--accent) 7%, var(--canvas)); border: 1px solid var(--edge); border-radius: 6px; text-wrap: pretty; }
      .help-foot b { color: var(--accent); transition: color 0.5s var(--ease); }
      .help-cta { inline-size: 100%; padding: 0.7rem 1rem; font-family: var(--mono); font-size: var(--fs-0); font-weight: 500; letter-spacing: 0.04em; color: var(--canvas); background: var(--accent); border: 0; border-radius: var(--radius); cursor: pointer; transition: background 0.5s var(--ease), filter 0.15s; }
      .help-cta:hover { filter: brightness(1.1); }

      /* ── knowledge base (lakehouse) ── */
      .kb-card { inline-size: min(44rem, 100%); }
      .kb-lede { margin: 0 0 var(--s2); color: var(--muted); line-height: 1.65; text-wrap: pretty; }
      .kb-lede b { color: var(--fg); }
      .kb-import { font-family: var(--mono); font-size: var(--fs--1); font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--canvas); background: var(--accent); border-radius: var(--radius); padding: 0.45rem 0.9rem; transition: background 0.5s var(--ease), filter 0.15s; }
      .kb-drop:hover .kb-import { filter: brightness(1.1); }
      .btn-plain { inline-size: fit-content; font-family: var(--mono); font-size: var(--fs--1); letter-spacing: 0.06em; color: var(--fg); background: var(--surface-2); border: 1px solid var(--line); border-radius: var(--radius); padding: 0.5rem 0.85rem; cursor: pointer; transition: border-color 0.2s; }
      .btn-plain:hover { border-color: var(--accent); }
      /* toasts */
      .toasts { position: fixed; inset-block-end: var(--s3); inset-inline: 0; z-index: 50; display: grid; justify-items: center; gap: var(--s1); pointer-events: none; padding-inline: var(--s3); }
      .toast { pointer-events: auto; display: flex; align-items: center; gap: 0.6ch; max-inline-size: min(34rem, 92vw); padding: 0.6rem 0.9rem; font-size: var(--fs--1); color: var(--fg); background: var(--surface-2); border: 1px solid var(--line); border-radius: 8px; box-shadow: 0 12px 28px -16px rgb(0 0 0 / 0.9); }
      .toast.ok { border-color: color-mix(in oklab, var(--accent-rag) 45%, var(--line)); }
      .toast.err { border-color: color-mix(in oklab, var(--accent-llm) 45%, var(--line)); }
      .toast .tdot { inline-size: 7px; block-size: 7px; border-radius: 50%; background: var(--accent); flex-shrink: 0; }
      .toast.ok .tdot { background: var(--accent-rag); }
      .toast.err .tdot { background: var(--accent-llm); }
      .toast.busy .tdot { animation: genblink 0.8s steps(1) infinite; }
      .toast b { color: var(--fg); font-weight: 600; }
      .toast .tdom { color: var(--accent-rag); font-weight: 600; }
      .kb-drop {
        display: grid; place-items: center; gap: 0.4rem; text-align: center;
        padding: var(--s4) var(--s3); cursor: pointer; color: var(--muted);
        background: var(--canvas); border: 1.5px dashed var(--line); border-radius: 8px;
        transition: border-color 0.2s var(--ease), background 0.2s var(--ease), color 0.2s;
      }
      .kb-drop:hover, .kb-drop.drag { border-color: var(--accent); color: var(--fg); background: color-mix(in oklab, var(--accent) 6%, var(--canvas)); }
      .kb-drop svg { color: var(--accent); transition: color 0.5s var(--ease); }
      .kb-drop-t b { color: var(--fg); }
      .kb-drop-s { letter-spacing: 0.12em; }
      .kb-queue { display: grid; gap: 0.3rem; }
      .kb-item { display: flex; align-items: center; gap: var(--s1); font-size: var(--fs--1); padding: 0.4rem 0.6rem; background: var(--surface); border: 1px solid var(--line-soft); border-radius: var(--radius); }
      .kb-item .n { flex: 1; min-inline-size: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--fg); }
      .kb-item .st { font-family: var(--mono); letter-spacing: 0.08em; text-transform: uppercase; }
      .kb-item.ok .st { color: var(--accent-rag); }
      .kb-item.dup .st { color: var(--muted); }
      .kb-item.err .st { color: var(--accent-llm); }
      .kb-item.run .st { color: var(--accent); }
      .kb-list-head { display: flex; align-items: center; justify-content: space-between; margin-block-start: var(--s2); padding-block-end: var(--s1); border-block-end: 1px solid var(--line-soft); }
      .kb-refresh { font-family: var(--mono); font-size: var(--fs--1); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); background: transparent; border: 1px solid var(--line-soft); border-radius: var(--radius); padding: 0.3rem 0.6rem; cursor: pointer; transition: color 0.2s, border-color 0.2s; }
      .kb-refresh:hover { color: var(--fg); border-color: var(--accent); }
      .kb-table { display: grid; gap: 2px; max-block-size: 18rem; overflow-y: auto; }
      .kb-row { display: grid; grid-template-columns: 1fr auto auto; gap: var(--s2); align-items: center; padding: 0.5rem 0.6rem; background: var(--surface); border: 1px solid var(--line-soft); border-radius: var(--radius); font-size: var(--fs--1); }
      .kb-row .doc { min-inline-size: 0; }
      .kb-row .doc b { display: block; color: var(--fg); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }
      .kb-row .doc span { color: var(--faint); }
      .kb-row .ch { color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
      .kb-row .dm { font-family: var(--mono); color: var(--accent-rag); letter-spacing: 0.06em; white-space: nowrap; }

      /* ── responsive: sidebar becomes a drawer ── */
      @media (max-width: 52rem) {
        .app { grid-template-columns: 1fr; }
        .side { position: fixed; inset-block: 0; inset-inline-start: 0; z-index: 31; inline-size: min(82vw, var(--side-w)); transform: translateX(-102%); transition: transform 0.28s var(--ease); }
        .app.side-open .side { transform: translateX(0); }
        .side-collapse { display: inline-grid; }
        .side-open { display: inline-grid; }
      }
      @media (min-width: 52.01rem) { .scrim { display: none !important; } }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
      }
    </style>

    <script>
      import { gsap, reveal, conceal, openModal, closeModal, animateLogo, pingLogo, RM } from '../lib/motion';

      const $ = (s, r = document) => r.querySelector(s);
      const $$ = (s, r = document) => [...r.querySelectorAll(s)];
      const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]);
      const root = document.documentElement;
      const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 7);
      const KEY = 'rag.chat.v1';

      const SUGGESTS = [
        'What is a Pod in Kubernetes?',
        'Why containerize an app with Docker?',
        'What does continuous integration mean?',
        'What is MLflow for?',
      ];

      // ── persistent state ──
      const defaults = () => ({ profile: { name: 'You', defaultMode: 'llm', topK: 5 }, convos: [], currentId: null });
      let S = load();
      function load() {
        try {
          const raw = JSON.parse(localStorage.getItem(KEY));
          if (raw && raw.profile && Array.isArray(raw.convos)) return raw;
        } catch {}
        return defaults();
      }
      function save() { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch {} }
      const current = () => S.convos.find((c) => c.id === S.currentId) || null;

      // ── markdown + citations ──
      function md(raw) {
        const safe = esc(raw);
        const parts = safe.split('```');
        let html = '';
        parts.forEach((part, i) => {
          if (i % 2 === 1) html += `<pre><code>${part.replace(/^[a-z0-9+-]*\n/i, '').replace(/\n+$/, '')}</code></pre>`;
          else html += blocks(part);
        });
        return html;
      }
      function blocks(text) {
        // inline : code (protégé en 1er) → gras → italique → lien → citation [n]
        const inline = (s) => s
          .replace(/`([^`]+)`/g, '<code>$1</code>')
          .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
          .replace(/\*(?!\s)([^*\n]+?)\*/g, '<em>$1</em>')
          .replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>')
          .replace(/\[(\d+)\]/g, '<sup class="cite" data-n="$1">[$1]</sup>');
        const lines = text.split('\n');
        let out = '', list = null, quote = false;
        const flush = () => {
          if (list) { out += `</${list}>`; list = null; }
          if (quote) { out += '</blockquote>'; quote = false; }
        };
        for (const ln of lines) {
          const t = ln.trim();
          if (!t) { flush(); continue; }
          let m;
          if ((m = t.match(/^(#{1,6})\s+(.*)/))) {
            flush(); const lvl = Math.min(m[1].length + 2, 6); out += `<h${lvl}>${inline(m[2])}</h${lvl}>`;
          } else if (/^(-{3,}|\*{3,}|_{3,})$/.test(t)) {
            flush(); out += '<hr>';
          } else if ((m = t.match(/^>\s?(.*)/))) {
            if (!quote) { flush(); out += '<blockquote>'; quote = true; } out += `<p>${inline(m[1])}</p>`;
          } else if ((m = t.match(/^[-*•]\s+(.*)/))) {
            if (list !== 'ul') { flush(); out += '<ul>'; list = 'ul'; } out += `<li>${inline(m[1])}</li>`;
          } else if ((m = t.match(/^\d+[.)]\s+(.*)/))) {
            if (list !== 'ol') { flush(); out += '<ol>'; list = 'ol'; } out += `<li>${inline(m[1])}</li>`;
          } else {
            flush(); out += `<p>${inline(t)}</p>`;
          }
        }
        flush();
        return out;
      }

      // ── mode (per conversation) ──
      const FOOT = { llm: 'REASONING · LLM — explains, no sources', rag: 'KNOWLEDGE · Graph-RAG — grounded, with citations' };
      function applyMode(mode) {
        root.dataset.mode = mode;
        $$('.selector [role="switch"]').forEach((b) => b.setAttribute('aria-checked', String(mode === 'rag')));
        $('#composerFoot').textContent = FOOT[mode];
      }
      function setMode(mode) {
        const c = current();
        const changed = root.dataset.mode !== mode;
        if (c) { c.mode = mode; save(); renderConvos(); }
        applyMode(mode);
        if (changed) $$('[data-logo]').forEach(pingLogo); // the graph "connects" on mode switch
      }
      $$('[data-mode-switch] .sel-switch').forEach((b) => b.addEventListener('click', () => setMode(root.dataset.mode === 'rag' ? 'llm' : 'rag')));
      $$('[data-mode-switch] .sel-side').forEach((s) => s.addEventListener('click', () => setMode(s.dataset.for)));

      // ── sidebar: conversation list ──
      const convosEl = $('#convos');
      function renderConvos() {
        if (!S.convos.length) { convosEl.innerHTML = '<p class="convos-empty">No chats yet.</p>'; return; }
        convosEl.innerHTML = S.convos.map((c) => `
          <div class="convo m-${c.mode} ${c.id === S.currentId ? 'active' : ''}" data-id="${c.id}" role="button" tabindex="0">
            <span class="convo-dot" aria-hidden="true"></span>
            <span class="convo-title" title="${esc(c.title)}">${esc(c.title)}</span>
            <button class="convo-del" type="button" aria-label="Delete chat" title="Delete">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M8 6V4h8v2m-9 0 1 14h8l1-14"/></svg>
            </button>
          </div>`).join('');
        $$('.convo', convosEl).forEach((el) => {
          const id = el.dataset.id;
          const title = $('.convo-title', el);
          el.addEventListener('click', (e) => { if (e.target.closest('.convo-del') || title.isContentEditable) return; selectConvo(id); });
          el.addEventListener('keydown', (e) => { if ((e.key === 'Enter' || e.key === ' ') && !title.isContentEditable) { e.preventDefault(); selectConvo(id); } });
          $('.convo-del', el).addEventListener('click', (e) => { e.stopPropagation(); deleteConvo(id); });
          title.addEventListener('dblclick', (e) => { e.stopPropagation(); startRename(title, id); });
        });
      }
      function startRename(el, id) {
        el.setAttribute('contenteditable', 'true'); el.focus();
        const sel = getSelection(); sel.selectAllChildren(el);
        const finish = () => {
          el.removeAttribute('contenteditable');
          const v = el.textContent.trim();
          const c = S.convos.find((x) => x.id === id);
          if (c) { c.title = v || c.title; c.renamed = true; save(); }
          renderConvos();
        };
        el.addEventListener('blur', finish, { once: true });
        el.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); el.blur(); } if (e.key === 'Escape') { el.textContent = S.convos.find((x) => x.id === id)?.title || ''; el.blur(); } });
      }

      function newConvo() {
        const c = { id: uid(), title: 'New chat', mode: S.profile.defaultMode, messages: [], renamed: false };
        S.convos.unshift(c); S.currentId = c.id; save();
        renderAll(); closeDrawer(); $('#askInput').focus();
      }
      function selectConvo(id) { S.currentId = id; save(); renderAll(); closeDrawer(); }
      function deleteConvo(id) {
        const i = S.convos.findIndex((c) => c.id === id);
        if (i < 0) return;
        S.convos.splice(i, 1);
        if (S.currentId === id) S.currentId = S.convos[0]?.id || null;
        if (!S.convos.length) newConvo(); else { save(); renderAll(); }
      }

      // ── thread render ──
      const app = $('#app'), threadInner = $('#threadInner'), greeting = $('#greeting');
      const bottomDock = $('#bottomDock'), composerForm = $('#composerForm');
      function greetWord() { const h = new Date().getHours(); return h < 12 ? 'morning' : h < 18 ? 'afternoon' : 'evening'; }

      function renderAll() {
        const c = current();
        renderConvos();
        $('#topTitle').textContent = c ? c.title : 'New chat';
        applyMode(c ? c.mode : S.profile.defaultMode);

        // clear previous messages (keep greeting node)
        $$('.msg', threadInner).forEach((n) => n.remove());

        const empty = !c || c.messages.length === 0;
        app.classList.toggle('empty', empty);
        greeting.hidden = !empty;
        if (empty) {
          $('#greetH').textContent = `Good ${greetWord()}, ${S.profile.name || 'there'}.`;
          const hero = $('.logo-hero');
          if (!heroDone) { heroDone = true; animateLogo(hero, { delay: booted ? 0.05 : 0.35 }); }
          else pingLogo(hero);
          if (booted && !RM) {
            gsap.from(['.greet-fig', '.greet-h', '.greet-sub', '.pillar'], { y: 12, autoAlpha: 0, stagger: 0.05, duration: 0.5, clearProps: 'transform,opacity,visibility' });
          }
          // move composer into the greeting block, centered
          if (!greeting.contains(composerForm)) {
            greeting.appendChild(composerForm);
            if (!$('.suggests', greeting)) {
              const box = document.createElement('div'); box.className = 'suggests';
              box.innerHTML = SUGGESTS.map((q) => `<button type="button" class="suggest">${esc(q)}</button>`).join('');
              greeting.appendChild(box);
              $$('.suggest', box).forEach((b) => b.addEventListener('click', () => submit(b.textContent)));
            }
          }
        } else {
          // dock composer at the bottom
          if (!bottomDock.contains(composerForm)) bottomDock.insertBefore(composerForm, bottomDock.firstChild);
          const fresh = [];
          for (const m of c.messages) {
            const el = renderMsg(m);
            threadInner.appendChild(el);
            if (!seen.has(m)) { seen.add(m); fresh.push(['enter', el, m]); }
            else if (wasPending.has(m) && !m.pending) { wasPending.delete(m); fresh.push(['answer', el, m]); }
            if (m.pending) wasPending.add(m);
          }
          animateFresh(fresh);
          scrollBottom();
        }
        syncComposer();
      }

      // ── message motion: only new things move; old history renders still ──
      const seen = new WeakSet(), wasPending = new WeakSet();
      let heroDone = false, booted = false;
      function animateFresh(list) {
        list.forEach(([kind, el, m], i) => {
          if (kind === 'enter') {
            reveal(el, m.role === 'user' ? { x: 16, y: 0, scale: 1, delay: i * 0.05 } : { y: 10, delay: 0.08 + i * 0.05 });
          }
          if (kind === 'answer' || (kind === 'enter' && !m.pending && m.role === 'assistant')) {
            const body = $('.body', el);
            if (body && kind === 'answer') reveal(body, { y: 6, duration: 0.45 });
            const cards = $$('.src-card', el);
            if (cards.length && !RM) gsap.from(cards, { autoAlpha: 0, y: 8, stagger: 0.05, delay: 0.2, clearProps: 'all' });
            countUp(el);
          }
        });
      }
      // receipt numbers count up from zero
      function countUp(scope) {
        if (RM) return;
        $$('[data-count]', scope).forEach((b) => {
          const end = parseFloat(b.dataset.count), dec = +(b.dataset.dec || 0), o = { v: 0 };
          gsap.to(o, { v: end, duration: 0.9, delay: 0.25, ease: 'power2.out',
            onUpdate: () => { b.textContent = o.v.toFixed(dec); } });
        });
      }

      function renderMsg(m) {
        const el = document.createElement('div');
        el.className = 'msg ' + m.role;
        if (m.role === 'user') {
          el.innerHTML = `<span class="label msg-role"><span class="dot"></span>YOU</span><div class="bubble">${esc(m.content)}</div>`;
          return el;
        }
        const chip = m.pending ? ''
          : m.method === 'scope' ? '<span class="chip scope">OUT OF SCOPE</span>'
          : m.method === 'idk' ? '<span class="chip scope">NOT IN CORPUS</span>'
          : m.grounded ? `<span class="chip grounded">GROUNDED · ${m.method === 'graph' ? 'GRAPH-RAG' : 'RAG'}</span>`
          : '<span class="chip ungrounded">UNGROUNDED · INTUITION</span>';
        const label = `<span class="label msg-role"><span class="dot"></span>ASSISTANT · ${(m.mode || 'llm').toUpperCase()}</span>`;
        const bodyHtml = m.pending
          ? `<div class="cc" role="status" aria-live="polite">
               <div class="cc-line"><span class="cc-glyph" aria-hidden="true">${GLYPHS[0]}</span><span class="cc-verb">${esc(live?.verbText || firstVerb(m.mode))}</span><span class="cc-time">${elapsedText()}</span></div>
               <div class="gpu-live">${gauge('util', 'GPU')}${gauge('vram', 'VRAM')}${gauge('temp', 'TEMP')}${gauge('power', 'POWER')}</div>
               <span class="gpu-name" data-g="name"></span>
             </div>`
          : (m.error ? `<p class="err">ERROR · ${esc(m.error)} — is the API running? <code>uv run uvicorn api.main:app --port 8000</code></p>` : md(m.content));
        const receipt = !m.pending && !m.error ? receiptHtml(m.metrics) : '';
        let sources = '';
        if (!m.pending && m.grounded && m.sources?.length) {
          sources = `<details class="sources-wrap" open><summary class="sources-sum">Sources · ${m.sources.length}</summary>
            <div class="sources">${m.sources.map((s) => `
              <div class="src-card" data-n="${s.n}"><div class="src-head"><span class="src-n">[${s.n}]</span><span class="src-path">${esc(s.source)}</span><span class="src-score">${s.score ?? ''}</span></div><p class="src-snip">${esc(s.text || '')}</p></div>`).join('')}</div></details>`;
        }
        el.innerHTML = `${label}<div class="body"><div class="answer">${chip}${bodyHtml}</div>${receipt}${sources}</div>`;
        if (m.pending && lastGpu) paintGpu(el, lastGpu, false);
        // inline [n] → scroll to its source card (scoped to this message)
        $$('.cite', el).forEach((cit) => cit.addEventListener('click', () => {
          const card = $(`.src-card[data-n="${cit.dataset.n}"]`, el);
          const det = $('details', el); if (det) det.open = true;
          if (card) { card.scrollIntoView({ behavior: 'smooth', block: 'center' }); card.classList.add('flash'); setTimeout(() => card.classList.remove('flash'), 1200); }
        }));
        return el;
      }

      const thread = $('#thread');
      function scrollBottom() { requestAnimationFrame(() => { thread.scrollTop = thread.scrollHeight; }); }

      // ── live inference: Claude-Code-style status line + GPU telemetry ──
      const GLYPHS = ['·', '✢', '✳', '✶', '✻', '✽', '✻', '✶', '✳', '✢'];
      const VERBS = {
        rag: ['Retrieving', 'Traversing the graph', 'Ranking passages', 'Connecting relations', 'Cross-referencing', 'Grounding claims', 'Citing sources', 'Assembling evidence'],
        llm: ['Reasoning', 'Compiling thoughts', 'Refactoring ideas', 'Containerizing intuition', 'Orchestrating', 'Debugging assumptions', 'Engineering an answer', 'Shipping'],
      };
      let live = null, lastGpu = null;
      const firstVerb = (mode) => VERBS[mode === 'rag' ? 'rag' : 'llm'][0] + '…';
      const elapsedText = () => `(${live ? ((performance.now() - live.t0) / 1000).toFixed(1) : '0.0'}s · ${live?.mode === 'rag' ? 'graph-rag' : 'reasoning'})`;
      const shortGpu = (n) => String(n || '').replace(/^NVIDIA\s+(GeForce\s+)?/i, '');

      function gauge(k, label) {
        return `<div class="g" data-g="${k}"><div class="g-top"><span class="gl">${label}</span><b class="gv">—</b></div><span class="gbar"><i></i></span></div>`;
      }
      function paintGpu(scope, s, animate = true) {
        if (!s || !s.available) return;
        const vals = {
          util: [s.util, `${s.util}<small>%</small>`],
          vram: [s.mem_used_mb / s.mem_total_mb * 100, `${(s.mem_used_mb / 1024).toFixed(1)}<small>/${(s.mem_total_mb / 1024).toFixed(0)} GB</small>`],
          temp: [Math.min(100, s.temp_c / 90 * 100), `${s.temp_c}<small>°C</small>`],
          power: [Math.min(100, s.power_w / 115 * 100), `${s.power_w.toFixed(0)}<small> W</small>`],
        };
        $$('.g', scope).forEach((g) => {
          const v = vals[g.dataset.g]; if (!v) return;
          $('.gv', g).innerHTML = v[1];
          const bar = $('.gbar i', g);
          if (animate && !RM) gsap.to(bar, { width: `${v[0]}%`, duration: 0.6, ease: 'power2.out', overwrite: 'auto' });
          else bar.style.width = `${v[0]}%`;
        });
        $$('[data-g="name"]', scope).forEach((n) => { n.textContent = `${shortGpu(s.name)} · live`; });
      }
      async function pollGpu() {
        try {
          const s = await (await fetch('/api/gpu')).json();
          lastGpu = s;
          $$('.cc').forEach((cc) => paintGpu(cc, s));
          if (live) {
            const loading = s.model_loaded === false;
            if (loading && !live.loading) swapVerb('Loading model weights…');
            live.loading = loading;
          }
        } catch {}
      }
      function swapVerb(text) {
        live.verbText = text;
        $$('.cc-verb').forEach((v) => {
          if (RM) { v.textContent = text; return; }
          // out = up & fade, in = from below — mirror images of each other
          gsap.timeline()
            .to(v, { y: -6, autoAlpha: 0, duration: 0.18, ease: 'power2.in' })
            .add(() => { v.textContent = text; })
            .fromTo(v, { y: 6, autoAlpha: 0 }, { y: 0, autoAlpha: 1, duration: 0.18, ease: 'power2.out' });
        });
      }
      function startLive(mode) {
        stopLive();
        const verbs = VERBS[mode === 'rag' ? 'rag' : 'llm'];
        let gi = 0, vi = 0;
        live = { mode, t0: performance.now(), verbText: verbs[0] + '…', timers: [] };
        live.timers.push(
          setInterval(() => { gi = (gi + 1) % GLYPHS.length; $$('.cc-glyph').forEach((g) => { g.textContent = GLYPHS[gi]; }); }, 110),
          setInterval(() => { $$('.cc-time').forEach((t) => { t.textContent = elapsedText(); }); }, 100),
          setInterval(() => { if (live.loading) return; vi = (vi + 1) % verbs.length; swapVerb(verbs[vi] + '…'); }, 2400),
          setInterval(pollGpu, 650),
        );
        pollGpu();
      }
      function stopLive() { if (!live) return; live.timers.forEach(clearInterval); live = null; }

      function receiptHtml(x) {
        if (!x || !x.new_tokens) return '';
        const n = (v, dec = 0) => `<b data-count="${v}" data-dec="${dec}">${Number(v).toFixed(dec)}</b>`;
        const p = [`<span class="bolt" aria-hidden="true">⚡</span>`,
          `<span class="rc">${n(x.new_tokens)} tokens</span>`];
        if (x.tok_s) p.push(`<span class="rc hot">${n(x.tok_s, 1)} tok/s</span>`);
        p.push(`<span class="rc">generation ${n(x.gen_ms / 1000, 2)}s</span>`);
        if (x.retrieval_ms != null) p.push(`<span class="rc">retrieval ${n(x.retrieval_ms)}ms</span>`);
        if (x.prompt_tokens) p.push(`<span class="rc">context ${n(x.prompt_tokens)} tok</span>`);
        if (x.peak_vram_mb) p.push(`<span class="rc">peak VRAM ${n(x.peak_vram_mb / 1024, 2)} GB</span>`);
        p.push(`<span class="rc dev">${esc(shortGpu(x.device))} · ${esc(x.dtype || '')}${x.adapter ? ' · LoRA' : ''}</span>`);
        return `<div class="receipt" aria-label="Inference metrics">${p.join('')}</div>`;
      }

      // ── composer ──
      const ta = $('#askInput'), sendBtn = $('#runBtn');
      function syncComposer() { ta.style.height = 'auto'; ta.style.height = Math.min(ta.scrollHeight, 176) + 'px'; sendBtn.disabled = ta.value.trim().length === 0; }
      ta.addEventListener('input', syncComposer);
      ta.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.shiftKey && !e.isComposing) { e.preventDefault(); submit(ta.value); } });
      composerForm.addEventListener('submit', (e) => { e.preventDefault(); submit(ta.value); });

      let busy = false;
      async function submit(text) {
        const q = (text || '').trim();
        if (!q || busy) return;
        let c = current();
        if (!c) { newConvo(); c = current(); }
        const mode = c.mode;
        ta.value = ''; syncComposer();

        // contexte conversationnel : tours terminés avant ce message (max 8)
        const history = c.messages
          .filter((m) => m.content && (m.role === 'user' || (m.role === 'assistant' && !m.pending && !m.error)))
          .slice(-8)
          .map((m) => ({ role: m.role, content: m.content }));

        c.messages.push({ role: 'user', content: q });
        if (!c.renamed && c.messages.filter((m) => m.role === 'user').length === 1) {
          c.title = q.length > 42 ? q.slice(0, 42) + '…' : q;
          $('#topTitle').textContent = c.title;
        }
        const aMsg = { role: 'assistant', mode, pending: true };
        c.messages.push(aMsg);
        startLive(mode);
        save(); renderAll();

        busy = true;
        try {
          const r = await fetch('/api/ask', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ question: q, mode, top_k: S.profile.topK, history }) });
          if (!r.ok) throw new Error(`HTTP ${r.status}`);
          const d = await r.json();
          Object.assign(aMsg, { pending: false, content: d.answer, grounded: d.grounded, method: d.method, sources: d.sources || [], metrics: d.metrics || {} });
        } catch (e) {
          Object.assign(aMsg, { pending: false, error: (e && e.message) || String(e), content: '' });
        } finally {
          stopLive();
          busy = false; save(); renderAll();
        }
      }

      // ── drawer (mobile) ──
      const scrim = $('#scrim');
      function openDrawer() { app.classList.add('side-open'); scrim.hidden = false; }
      function closeDrawer() { app.classList.remove('side-open'); scrim.hidden = true; }
      $('#sideOpen').addEventListener('click', openDrawer);
      $('#sideClose').addEventListener('click', closeDrawer);
      scrim.addEventListener('click', closeDrawer);
      $('#newChat').addEventListener('click', newConvo);

      // ── settings modal ──
      const modal = $('#settings');
      function openSettings() {
        $('#setName').value = S.profile.name;
        $('#setTopK').value = S.profile.topK; $('#topKVal').textContent = S.profile.topK;
        $$('#setMode .seg-btn').forEach((b) => b.classList.toggle('active', b.dataset.mode === S.profile.defaultMode));
        openModal(modal); $('#setName').focus();
      }
      function closeSettings() { return closeModal(modal); }
      $('#profileBtn').addEventListener('click', openSettings);
      $('#setClose').addEventListener('click', closeSettings);
      $$('[data-close]', modal).forEach((n) => n.addEventListener('click', closeSettings));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) closeSettings(); });

      $('#setName').addEventListener('input', (e) => { S.profile.name = e.target.value.slice(0, 40); applyProfile(); save(); });
      $('#setTopK').addEventListener('input', (e) => { S.profile.topK = +e.target.value; $('#topKVal').textContent = e.target.value; save(); });
      $$('#setMode .seg-btn').forEach((b) => b.addEventListener('click', () => {
        S.profile.defaultMode = b.dataset.mode; $$('#setMode .seg-btn').forEach((x) => x.classList.toggle('active', x === b)); save();
      }));
      $('#clearAll').addEventListener('click', () => {
        if (!confirm('Delete all conversations? This cannot be undone.')) return;
        S.convos = []; S.currentId = null; save(); newConvo(); closeSettings();
      });

      function applyProfile() {
        const name = S.profile.name || 'You';
        $('#profileName').textContent = name;
        $('#avatar').textContent = (name.trim()[0] || 'Y').toUpperCase();
        if (current() && current().messages.length === 0) $('#greetH').textContent = `Good ${greetWord()}, ${name}.`;
      }

      // ── help / tutorial modal ──
      const help = $('#help');
      function openHelp() { openModal(help); $('#helpClose').focus(); }
      function closeHelp() { return closeModal(help); }
      $('#helpBtn').addEventListener('click', () => { openHelp(); closeDrawer(); });
      $('#helpClose').addEventListener('click', closeHelp);
      $('#helpStart').addEventListener('click', () => { closeHelp(); $('#askInput').focus(); });
      $$('[data-close-help]', help).forEach((n) => n.addEventListener('click', closeHelp));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !help.hidden) closeHelp(); });
      // first visit → show the tutorial once
      try {
        if (!localStorage.getItem('rag.chat.seen')) { openHelp(); localStorage.setItem('rag.chat.seen', '1'); }
      } catch {}

      // ── toasts ──
      const toastsEl = $('#toasts');
      function toast(html, kind = '', ms = 4000) {
        const el = document.createElement('div');
        el.className = 'toast ' + kind;
        el.innerHTML = `<span class="tdot"></span><span>${html}</span>`;
        toastsEl.appendChild(el);
        reveal(el, { y: 12, scale: 0.96 });
        let gone = false;
        const kill = () => { if (gone) return; gone = true; conceal(el).then(() => el.remove()); };
        if (ms) setTimeout(kill, ms);
        return { el, kill };
      }

      // ── knowledge base (lakehouse) ──
      const kb = $('#knowledge');
      function openKB() { openModal(kb); loadDocs(); }
      function closeKB() { return closeModal(kb); }
      $('#openKbFromSettings').addEventListener('click', async () => { await closeSettings(); openKB(); });
      $('#kbClose').addEventListener('click', closeKB);
      $$('[data-close-kb]', kb).forEach((n) => n.addEventListener('click', closeKB));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !kb.hidden) closeKB(); });

      async function loadDocs() {
        const t = $('#kbTable');
        try {
          const d = await (await fetch('/api/documents')).json();
          const docs = d.documents || [];
          $('#kbCount').textContent = docs.length;
          if (!docs.length) { t.innerHTML = '<p class="set-help">Nothing added yet — import a document above.</p>'; return; }
          t.innerHTML = docs.map((doc) =>
            `<div class="kb-row"><div class="doc"><b>${esc(doc.filename)}</b><span>${esc(doc.source)}</span></div><span class="dm">${esc(doc.domain)}</span><span class="ch">${doc.n_chunks} chunks</span></div>`
          ).join('');
        } catch { t.innerHTML = '<p class="set-help err">Could not load documents — is the API running?</p>'; }
      }
      $('#kbRefresh').addEventListener('click', loadDocs);

      // shared import (domain omitted => the system assigns it automatically)
      async function ingestFile(file) {
        const fd = new FormData(); fd.append('file', file);
        const r = await fetch('/api/ingest', { method: 'POST', body: fd });
        const d = await r.json();
        if (!r.ok) throw new Error(d.detail || ('HTTP ' + r.status));
        return d;
      }
      // ── composer attachment chips — the exit is the entrance played backwards ──
      const attachments = $('#attachments');
      const RING = '<svg class="ring" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-dasharray="38 100"/></svg>';
      const TICK = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path class="tick" pathLength="1" d="M5 12.5l4.2 4.2L19 7.5"/></svg>';
      const CROSS = '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path class="tick" pathLength="1" d="M7 7l10 10M17 7 7 17"/></svg>';

      function addChip(file) {
        const chip = document.createElement('div');
        chip.className = 'chip-att run';
        chip.innerHTML = `<span class="ca-ico">${RING}</span><span class="ca-name" title="${esc(file.name)}">${esc(file.name)}</span><span class="ca-st">reading…</span>`;
        const first = !attachments.children.length;
        attachments.appendChild(chip);
        if (first) reveal(attachments, { height: true, y: 0, scale: 1 }); // the row opens…
        reveal(chip, { width: true, y: 4, scale: 0.92 });                 // …and the chip grows in
        const spin = RM ? null : gsap.to($('.ring', chip), { rotation: 360, transformOrigin: '50% 50%', repeat: -1, ease: 'none', duration: 0.8 });
        return { chip, spin };
      }
      function settleChip({ chip, spin }, kind, label) {
        spin?.kill();
        const w0 = chip.offsetWidth;
        chip.className = 'chip-att ' + kind;
        const ico = $('.ca-ico', chip);
        ico.innerHTML = kind === 'err' ? CROSS : TICK;
        $('.ca-st', chip).textContent = label;
        if (!RM) {
          const w1 = chip.offsetWidth; // the label changed: glide to the new width
          gsap.fromTo(chip, { width: w0 }, { width: w1, duration: 0.3, ease: 'power2.out', overwrite: 'auto', clearProps: 'width' });
          gsap.fromTo(ico, { scale: 0.6 }, { scale: 1, duration: 0.42, ease: 'back.out(3)' });
          gsap.fromTo($('.tick', ico), { strokeDasharray: 1, strokeDashoffset: 1 }, { strokeDashoffset: 0, duration: 0.35, delay: 0.05, ease: 'power2.out' });
        }
        setTimeout(() => removeChip(chip), kind === 'ok' ? 2800 : 3800);
      }
      async function removeChip(chip) {
        const last = attachments.children.length === 1;
        // chip shrinks back to zero width; if it was the last one the row closes too —
        // both are their own entrances reversed, so the exit mirrors the entrance.
        await Promise.all([conceal(chip), last ? conceal(attachments) : Promise.resolve()]);
        chip.remove();
        if (!attachments.children.length) gsap.set(attachments, { clearProps: 'all' });
      }

      async function importFiles(files, { queue = false } = {}) {
        if (!files.length) return;
        if (!queue) attachBtn.classList.add('busy');
        for (const f of files) {
          let row = null, chip = null;
          if (queue) {
            row = document.createElement('div'); row.className = 'kb-item run';
            row.innerHTML = `<span class="n">${esc(f.name)}</span><span class="st">reading…</span>`;
            kbQueue.prepend(row); reveal(row, { y: 6 });
          } else {
            chip = addChip(f);
          }
          try {
            const d = await ingestFile(f);
            if (d.status === 'ingested') {
              if (row) { row.className = 'kb-item ok'; $('.st', row).textContent = `+${d.chunks_added} · ${d.domain}`; }
              if (chip) settleChip(chip, 'ok', `added to ${d.domain}`);
            } else if (d.status === 'duplicate') {
              if (row) { row.className = 'kb-item dup'; $('.st', row).textContent = 'already added'; }
              if (chip) settleChip(chip, 'dup', 'already known');
            } else {
              if (row) { row.className = 'kb-item err'; $('.st', row).textContent = d.status; }
              if (chip) settleChip(chip, 'err', `couldn't read (${d.status})`);
            }
          } catch (e) {
            if (row) { row.className = 'kb-item err'; $('.st', row).textContent = 'error'; }
            if (chip) settleChip(chip, 'err', 'upload failed');
          }
        }
        if (!queue) attachBtn.classList.remove('busy');
        if (!kb.hidden) loadDocs();
      }

      // modal: drag-drop + browse
      const kbDrop = $('#kbDrop'), kbFile = $('#kbFile'), kbQueue = $('#kbQueue');
      ['dragenter', 'dragover'].forEach((ev) => kbDrop.addEventListener(ev, (e) => { e.preventDefault(); kbDrop.classList.add('drag'); }));
      ['dragleave', 'drop'].forEach((ev) => kbDrop.addEventListener(ev, (e) => { e.preventDefault(); kbDrop.classList.remove('drag'); }));
      kbDrop.addEventListener('drop', (e) => importFiles([...e.dataTransfer.files], { queue: true }));
      kbFile.addEventListener('change', () => { importFiles([...kbFile.files], { queue: true }); kbFile.value = ''; });

      // composer: claude-style attach button
      const attachBtn = $('#attachBtn'), composerFile = $('#composerFile');
      attachBtn.addEventListener('click', () => composerFile.click());
      composerFile.addEventListener('change', () => { importFiles([...composerFile.files], { queue: false }); composerFile.value = ''; });
      // drop files straight onto the composer
      const hasFiles = (e) => [...(e.dataTransfer?.types || [])].includes('Files');
      ['dragenter', 'dragover'].forEach((ev) => composerForm.addEventListener(ev, (e) => { if (hasFiles(e)) { e.preventDefault(); composerForm.classList.add('drop'); } }));
      ['dragleave', 'drop'].forEach((ev) => composerForm.addEventListener(ev, () => composerForm.classList.remove('drop')));
      composerForm.addEventListener('drop', (e) => { if (e.dataTransfer?.files?.length) { e.preventDefault(); importFiles([...e.dataTransfer.files]); } });

      // ── backend info / health ──
      (async function info() {
        try {
          const d = await (await fetch('/api/info')).json();
          const dev = String(d.device).toUpperCase();
          const stat = $('#profileStat'); stat.textContent = `● online · ${dev}`; stat.dataset.ok = '1';
          $('#infoStatus').textContent = 'online'; $('#infoDevice').textContent = dev;
          $('#infoEmbed').textContent = d.embedding_model; $('#infoLlm').textContent = d.llm_model;
          $('#infoChunks').textContent = `${d.n_chunks}`;
        } catch {
          $('#profileStat').textContent = '● offline — start the API';
          $('#infoStatus').textContent = 'offline';
        }
      })();

      // ── boot ──
      // history renders still; a reply interrupted by a reload is marked as such
      S.convos.forEach((c) => c.messages.forEach((m) => {
        if (m.pending) Object.assign(m, { pending: false, error: 'interrupted (page reloaded)', content: '' });
        seen.add(m);
      }));
      if (!S.convos.length) newConvo(); else { if (!current()) S.currentId = S.convos[0].id; applyProfile(); renderAll(); }
      applyProfile();

      // ── intro choreography + animated logos ──
      const sideLogo = $('.logo-side'), heroLogo = $('.logo-hero');
      animateLogo(sideLogo, { delay: 0.15 });
      $('#brand').addEventListener('mouseenter', () => pingLogo(sideLogo));
      heroLogo.addEventListener('mouseenter', () => pingLogo(heroLogo));
      if (!RM) {
        const intro = gsap.timeline({ defaults: { ease: 'power3.out', duration: 0.6 } });
        intro.from('.side', { x: -18, autoAlpha: 0, clearProps: 'transform,opacity,visibility' }, 0)
             .from('.side .new-chat, .side .side-section, .convo, .side-link, .profile', { y: 8, autoAlpha: 0, stagger: 0.04, duration: 0.45, clearProps: 'transform,opacity,visibility' }, 0.15);
        if (!greeting.hidden) {
          intro.from(['.greet-fig', '.greet-h', '.greet-sub', '.pillar', '#composerForm', '.composer-foot', '.suggest'],
            { y: 14, autoAlpha: 0, stagger: 0.055, clearProps: 'transform,opacity,visibility' }, 0.45);
        } else {
          intro.from('.topbar', { y: -8, autoAlpha: 0, clearProps: 'transform,opacity,visibility' }, 0.1)
               .from('#bottomDock', { y: 16, autoAlpha: 0, clearProps: 'transform,opacity,visibility' }, 0.25);
        }
      }
      booted = true;
    </script>
  </body>
</html>
